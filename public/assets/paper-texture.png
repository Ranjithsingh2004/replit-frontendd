<svg width="400" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <filter id="noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" seed="2" />
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncA type="discrete" tableValues="0 0 0 0 0.05 0.1 0.15" />
      </feComponentTransfer>
    </filter>
    <pattern id="paper" x="0" y="0" width="400" height="400" patternUnits="userSpaceOnUse">
      <rect width="400" height="400" fill="#FCF7F0" />
      <rect width="400" height="400" filter="url(#noise)" />
    </pattern>
  </defs>
  <rect width="400" height="400" fill="url(#paper)" />
</svg>
